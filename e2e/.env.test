# E2E Test Environment — Remote Logger Backend
#
# Copy this file to the same directory and fill in your real values.
# It is loaded automatically at the start of every E2E test run.
#
# To skip all E2E tests (e.g. in a CI environment without Docker):
#   SKIP_E2E=1 cargo test --test e2e_test

# Set to 1 or "true" to skip all E2E tests without removing them.
SKIP_E2E=0

# JWT secret used by the Pingora gateway. Must match the value the
# docker-compose stack is started with.
GATEWAY_JWT_SECRET=dev-e2e-jwt-secret-change-me

# Convenience overrides (defaults shown below are used if absent).
# GATEWAY_URL=http://localhost:8080
# OPENSEARCH_URL=http://localhost:9200
# LOG_CHANNEL=fancy-app-dev
