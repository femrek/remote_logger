COMPOSE_FILE=docker-compose.yaml,docker-compose-network.yaml
COMPOSE_PATH_SEPARATOR=,
COMPOSE_PROJECT_NAME=logger_backend

RUST_LOG=info,logger_gateway=debug,validation_worker=debug

# ── JWT ECC Keys ───────────────────────────────────────────────────────────────
# The validation worker uses the private key to sign/MINT tokens.
# The gateway uses the public key to verify/VALIDATE tokens.
# Generate a strong EC key pair for production:
#   openssl ecparam -name prime256v1 -genkey -noout -out private.pem
#   openssl pkcs8 -topk8 -nocrypt -in private.pem -out pkcs8_private.pem
#   openssl ec -in private.pem -pubout -out public.pem
GATEWAY_PRIVATE_KEY=
GATEWAY_PUBLIC_KEY=

# ── Gateway Network Configuration ────────────────────────────────────────────
# Bind address for the Pingora proxy listener.
GATEWAY_BIND_ADDR=0.0.0.0:8080
# Bind address for the Prometheus /metrics scrape endpoint.
GATEWAY_METRICS_ADDR=0.0.0.0:9090
# Uncomment to enable TLS termination at the gateway listener.
# Both paths must be set — if either is missing, TLS is disabled.
# GATEWAY_TLS_CERT_PATH=/etc/certs/server.crt
# GATEWAY_TLS_KEY_PATH=/etc/certs/server.key

# ── Gateway Admin Configurator ────────────────────────────────────────────────
# Bearer token required for all /api/* endpoints on logger_admin (port 8082).
# Generate a strong secret: openssl rand -hex 32
GATEWAY_ADMIN_TOKEN=<change_me>

# ── Validation Worker Configuration (Optional overrides) ──────────────────────
# KAFKA_BROKERS=broker:9094
# PORT=8000
# KAFKA_TOPIC=mobile-logs
# KAFKA_METADATA_TOPIC=device-metadata
# ACCESS_JWT_TTL_SECONDS=900
# REFRESH_JWT_TTL_SECONDS=604800
# JWT_ISSUER=logger-gateway
# WORKER_CONFIG=/app/config/channels.yaml

# ── Monitoring ────────────────────────────────────────────────────────────────
# Grafana admin password. Change this before running in any non-local environment.
GRAFANA_ADMIN_PASSWORD=
# Worker Prometheus metrics port (default: 9091, separate from API port 8000)
# METRICS_PORT=9091

# ── OpenSearch ────────────────────────────────────────────────────────────────
# OpenSearch admin password (minimum 8 chars, 1 upper, 1 lower, 1 digit, 1 special)
OPENSEARCH_ADMIN_PASSWORD=
